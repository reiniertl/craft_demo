        methodIdx
      );

      const args = regs.map((r) => ctx.frame.registers[r]);
      ctx.frame.pc += 3;
      ctx.interpreter.invokeMethod(method, args);
    },
  });

  // 0x70 - invoke-direct {vC, vD, vE, vF, vG}, meth@BBBB
  table.register(0x70, {
    name: 'invoke-direct',
