  // 0x69 - sput-object vAA, field@BBBB
  table.register(0x69, {
    name: 'sput-object',
    format: '21c',
    width: 2,
    handler: (ctx, insn) => {
      const vA = (insn >> 8) & 0xff;
      const code = ctx.frame.method.code!.insns;
      const fieldIdx = code[ctx.frame.pc + 1];

