            const signature = readUint32LE(data, pos);
            if (signature !== CD_SIGNATURE) {
                throw new ParseError('Invalid CD signature at entry ' + i + ': expected 0x' + CD_SIGNATURE.toString(16) + ', got 0x' + signature.toString(16), pos);
